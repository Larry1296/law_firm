# Copy to .env and fill in. Never commit .env.

# --- AI assistants -----------------------------------------------------------
# Every assistant (public homepage, client, advocate, firm owner, platform) asks Claude first
# and falls back to OpenAI when Claude fails, times out or has no key.
# AI_PROVIDER=openai tries OpenAI first instead. AI_FALLBACK_ENABLED=False uses one provider only.
# With no key at all, assistants still answer from the records, without AI wording.
AI_PROVIDER=auto
AI_FALLBACK_ENABLED=True
AI_REQUEST_TIMEOUT=20
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Questions each signed-in user may ask per hour, and per visitor on the public site.
DASHBOARD_ASSISTANT_RATE_LIMIT=60/hour
KNOWLEDGE_BASE_RATE_LIMIT=10/hour

# Sends de-identified matter facts to the model to tailor advocates' court preparation briefs.
AI_PREPARATION_LLM_ENABLED=False
