SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=lawfirm_database
DB_USER=lawfirm_user
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@sheriamaster.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Public Kenyan Legal Information Assistant (server-side only)
# The firm whose public website the chatbot answers for (LawFirm id).
PUBLIC_FIRM_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
KNOWLEDGE_BASE_MAX_CONTEXT_ITEMS=4
KNOWLEDGE_BASE_MIN_RELEVANCE=0.15
KNOWLEDGE_BASE_REQUEST_TIMEOUT=20
KNOWLEDGE_BASE_RATE_LIMIT=10/hour

# Internal lawyer case assessment (deterministic scoring; no external case data by default)
AI_EXTERNAL_RESEARCH_ENABLED=False
AI_CASE_ASSESSMENT_RETENTION_DAYS=365
AI_AUTOMATIC_REASSESSMENT_ENABLED=False
AI_KNOWLEDGE_INDEX_MODE=database

# SaaS subscriptions
# Public self-service firm sign-up at /register-firm (off until you launch it).
ALLOW_PUBLIC_FIRM_SIGNUP=False
FIRM_SIGNUP_RATE_LIMIT=5/hour
SUBSCRIPTION_TRIAL_PLAN=PRO
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_VAT_RATE=16.00
# M-Pesa Paybill business number shown on subscription invoices.
SUBSCRIPTION_MPESA_PAYBILL=
