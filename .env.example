ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=lawfirm_database
DB_USER=lawfirm_user
DB_PASSWORD=replace-with-a-local-password
